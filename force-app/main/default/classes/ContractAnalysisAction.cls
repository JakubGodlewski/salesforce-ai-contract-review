public with sharing class ContractAnalysisAction {

    public class Request {

        @InvocableVariable(
            required=true
            label='Opportunity Id'
            description='Id of the Opportunity whose contract should be analyzed.'
        )
        public Id opportunityId;

        @InvocableVariable(
            label='Contract PDF Version Id'
            description='Optional ContentVersion Id selected by the user. If omitted, the latest PDF is used.'
        )
        public Id contentVersionId;
    }


    public class Response {

        @InvocableVariable(
            label='Contract Review Id'
            description='Id of the created Contract Review record.'
        )
        public Id contractReviewId;

        @InvocableVariable(
            label='Overall Status'
            description='Overall result of the contract analysis.'
        )
        public String overallStatus;

        @InvocableVariable(
            label='Discrepancy Count'
            description='Number of discrepancies requiring attention.'
        )
        public Integer discrepancyCount;

        @InvocableVariable(
            label='Summary'
            description='Summary generated by the AI contract analysis.'
        )
        public String summary;
    }


    @InvocableMethod(
        label='Analyze Contract with AI'
        description='Analyzes the contract associated with an Opportunity and creates a Contract Review.'
    )
    public static List<Response> analyze(
        List<Request> requests
    ) {

        List<Response> responses = new List<Response>();

        for (Request request : requests) {

            ContractAnalysisService.AnalysisOutcome outcome =
                ContractAnalysisService.analyze(
                    request.opportunityId,
                    request.contentVersionId
                );

            Response response = new Response();

            response.contractReviewId =
                outcome.contractReviewId;

            response.overallStatus =
                outcome.result.overallStatus;

            response.summary =
                outcome.result.summary;

            response.discrepancyCount =
                countDiscrepancies(
                    outcome.result
                );

            responses.add(response);
        }

        return responses;
    }


    private static Integer countDiscrepancies(
        ContractAnalysisResult result
    ) {

        Integer count = 0;

        if (
            result == null ||
            result.comparisons == null
        ) {
            return count;
        }

        for (
            ContractAnalysisResult.Comparison comparison :
            result.comparisons
        ) {

            if (
                comparison.status == 'MISMATCH' ||
                comparison.status == 'UNKNOWN' ||
                comparison.status == 'AMBIGUOUS'
            ) {
                count++;
            }
        }

        return count;
    }
}